#include <behaviors.dtsi>
#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE   0
#define NAV    1
#define MOUSE  2
#define MEDIA  3
#define NUM    4
#define SYM    5
#define FUN    6
#define CONFIG 7

#define SSHOT LG(LC(LS(N4)))

/ {
    behaviors {
        // Match Miryoku's home-row mod behavior: rolls remain taps, and
        // modifiers activate only after being held through the tapping term.
        hm: home_row_mod {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;
        };

        // Thumb layer-taps are kept separate from home-row mod timing.
        thumb_lt: thumb_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <250>;
            bindings = <&mo>, <&kp>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        // Hold Backspace/Nav and Space/Sym together for hardware configuration.
        config_layer {
            if-layers = <NAV SYM>;
            then-layer = <CONFIG>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "BASE";
            bindings = <
                &kp Q          &kp W          &kp E           &kp R           &kp T               &kp Y           &kp U           &kp I           &kp O           &kp P
                &hm LGUI A     &hm LALT S     &hm LCTRL D     &hm LSHFT F     &kp G               &kp H           &hm RSHFT J     &hm RCTRL K     &hm RALT L      &hm RGUI SQT
                &kp GRAVE      &kp Z          &kp X           &kp C           &kp V           &kp B               &kp N           &kp M           &kp COMMA       &kp DOT         &kp FSLH        &kp EQUAL
                                                &thumb_lt NUM ESC  &thumb_lt NAV BSPC  &thumb_lt MOUSE TAB    &thumb_lt FUN DEL  &thumb_lt SYM SPACE  &thumb_lt MEDIA RET
            >;
        };

        nav_layer {
            display-name = "NAV";
            bindings = <
                &kp LG(N4)     &kp LG(N3)     &kp LG(N2)      &kp LG(N1)      &none               &kp LG(LS(Z))    &kp LG(V)       &kp LG(C)       &kp LG(X)       &kp LG(Z)
                &kp LGUI       &kp LALT       &kp LCTRL       &kp LSHFT       &none               &kp LEFT        &kp DOWN        &kp UP          &kp RIGHT       &caps_word
                &kp SSHOT      &none          &none           &none           &none           &none               &kp HOME        &kp PG_DN       &kp PG_UP       &kp END         &kp INS         &none
                                                &none                &none                &none                  &thumb_lt FUN DEL  &thumb_lt SYM SPACE  &thumb_lt MEDIA RET
            >;
        };

        mouse_layer {
            display-name = "MOUSE";
            bindings = <
                &none          &none          &none           &none           &none               &kp LG(LS(Z))    &kp LG(V)       &kp LG(C)       &kp LG(X)       &kp LG(Z)
                &kp LGUI       &kp LALT       &kp LCTRL       &kp LSHFT       &none               &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP    &mmv MOVE_RIGHT &none
                &none          &none          &none           &none           &none           &none               &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP    &msc SCRL_RIGHT &none           &none
                                                &none                &none                &none                  &mkp MB2           &mkp MB1            &mkp MB3
            >;
        };

        media_layer {
            display-name = "MEDIA";
            bindings = <
                &none          &none          &none           &none           &none               &kp SSHOT      &none           &none           &none           &none
                &kp C_PREV     &kp C_VOL_DN   &kp C_VOL_UP    &kp C_NEXT      &none               &none           &kp RSHFT      &kp RCTRL      &kp RALT       &kp RGUI
                &out OUT_TOG   &bt BT_SEL 0   &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4        &none           &none           &none           &none           &none           &none
                                                &kp C_STOP           &kp C_PP             &kp C_MUTE             &none              &none               &none
            >;
        };

        num_layer {
            display-name = "NUM";
            bindings = <
                &none          &none          &none           &none           &none               &kp LBKT       &kp N7         &kp N8         &kp N9         &kp RBKT
                &kp LGUI       &kp LALT       &kp LCTRL       &kp LSHFT       &none               &kp SEMI       &kp N4         &kp N5         &kp N6         &kp EQUAL
                &none          &none          &none           &none           &none           &none               &kp GRAVE      &kp N1         &kp N2         &kp N3         &kp BSLH       &none
                                                &none                &none                &none                  &kp DOT            &kp N0             &kp MINUS
            >;
        };

        sym_layer {
            display-name = "SYM";
            bindings = <
                &kp LBRC       &kp AMPS       &kp STAR        &kp LPAR        &kp RBRC            &none           &none           &none           &none           &none
                &kp COLON      &kp DLLR       &kp PRCNT       &kp CARET       &kp PLUS            &none           &kp RSHFT      &kp RCTRL      &kp RALT       &kp RGUI
                &none          &kp TILDE      &kp EXCL        &kp AT          &kp HASH        &kp PIPE            &none           &none           &none           &none           &none           &none
                                                &kp LPAR             &thumb_lt NAV RPAR    &kp UNDER              &none              &none               &none
            >;
        };

        fun_layer {
            display-name = "FUN";
            bindings = <
                &kp F12        &kp F7         &kp F8          &kp F9          &kp PSCRN           &none           &none           &none           &none           &none
                &kp F11        &kp F4         &kp F5          &kp F6          &kp SLCK            &none           &kp RSHFT      &kp RCTRL      &kp RALT       &kp RGUI
                &none          &kp F10        &kp F1          &kp F2          &kp F3          &kp PAUSE_BREAK     &none           &none           &none           &none           &none           &none
                                                &kp K_APP            &kp SPACE            &kp TAB                &none              &none               &none
            >;
        };

        config_layer {
            display-name = "CONFIG";
            bindings = <
                &sys_reset     &bootloader    &out OUT_TOG    &out OUT_USB    &out OUT_BLE        &none           &none           &none           &none           &none
                &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2    &bt BT_SEL 3   &bt BT_SEL 4        &none           &none           &none           &none           &none
                &none          &bt BT_CLR     &bt BT_PRV      &bt BT_NXT      &none          &none               &none           &none           &none           &none           &none           &none
                                                &none                &none                &none                  &none              &none               &none
            >;
        };
    };
};
